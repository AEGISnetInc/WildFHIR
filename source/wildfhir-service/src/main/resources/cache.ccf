##############################################################
################## DEFAULT CACHE REGION  #####################
# sets the default aux value for any non configured caches
jcs.default=FHIR_PAGING_CACHE
jcs.default.cacheattributes=org.apache.commons.jcs3.engine.CompositeCacheAttributes
jcs.default.cacheattributes.MaxObjects=1000
jcs.default.cacheattributes.MemoryCacheName=org.apache.commons.jcs3.engine.memory.lru.LRUMemoryCache
jcs.default.cacheattributes.UseMemoryShrinker=true
jcs.default.cacheattributes.maxMemoryIdleTimeSeconds=7200
jcs.default.cacheattributes.shrinkerIntervalSeconds=60
jcs.default.elementattributes=org.apache.commons.jcs3.engine.ElementAttributes
jcs.default.elementattributes.IsEternal=false
jcs.default.elementattributes.MaxLifeSeconds=7200
jcs.default.elementattributes.MaxIdleTimeSeconds=7200
jcs.default.elementattributes.IsSpool=true
jcs.default.elementattributes.IsRemote=true
jcs.default.elementattributes.IsLateral=true

##############################################################
################## CACHE REGIONS AVAILABLE ###################
# PRE-DEFINED CACHE REGIONS
jcs.region.fhirPagingCache=FHIR_PAGING_CACHE
jcs.region.fhirPagingCache.cacheattributes=org.apache.commons.jcs3.engine.CompositeCacheAttributes
jcs.region.fhirPagingCache.cacheattributes.MaxObjects=1000
jcs.region.fhirPagingCache.cacheattributes.MemoryCacheName=org.apache.commons.jcs3.engine.memory.lru.LRUMemoryCache
jcs.region.fhirPagingCache.cacheattributes.UseMemoryShrinker=true
jcs.region.fhirPagingCache.cacheattributes.maxMemoryIdleTimeSeconds=3600
jcs.region.fhirPagingCache.cacheattributes.shrinkerIntervalSeconds=60
jcs.region.fhirPagingCache.cacheattributes.MaxSpoolPerRun=500
jcs.region.fhirPagingCache.elementattributes=org.apache.commons.jcs3.engine.ElementAttributes
jcs.region.fhirPagingCache.elementattributes.IsEternal=false
jcs.region.fhirPagingCache.elementattributes.MaxLifeSeconds=3600
jcs.region.fhirPagingCache.elementattributes.MaxIdleTimeSeconds=3600

##############################################################
################## AUXILIARY CACHES AVAILABLE ################
# Disk cache used for FHIR_PAGING_CACHE
jcs.auxiliary.FHIR_PAGING_CACHE=org.apache.commons.jcs3.auxiliary.disk.indexed.IndexedDiskCacheFactory
jcs.auxiliary.FHIR_PAGING_CACHE.attributes=org.apache.commons.jcs3.auxiliary.disk.indexed.IndexedDiskCacheAttributes
jcs.auxiliary.FHIR_PAGING_CACHE.attributes.DiskPath=${java.io.tmpdir}/JCS_CACHE/FHIR_PAGING_CACHE
jcs.auxiliary.FHIR_PAGING_CACHE.attributes.MaxPurgatorySize=500000
jcs.auxiliary.FHIR_PAGING_CACHE.attributes.MaxKeySize=1000000
jcs.auxiliary.FHIR_PAGING_CACHE.attributes.MaxRecycleBinSize=5000
jcs.auxiliary.FHIR_PAGING_CACHE.attributes.OptimizeAtRemoveCount=300000
jcs.auxiliary.FHIR_PAGING_CACHE.attributes.ShutdownSpoolTimeLimit=60

##############################################################
################## OPTIONAL THREAD POOL CONFIGURATION #########
# Disk Cache pool
thread_pool.disk_cache_event_queue.useBoundary=true
thread_pool.disk_cache_event_queue.boundarySize=1000
thread_pool.disk_cache_event_queue.maximumPoolSize=15
thread_pool.disk_cache_event_queue.minimumPoolSize=5
thread_pool.disk_cache_event_queue.keepAliveTime=3500
thread_pool.disk_cache_event_queue.whenBlockedPolicy=RUN
thread_pool.disk_cache_event_queue.startUpSize=5